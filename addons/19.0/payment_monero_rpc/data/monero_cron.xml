<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_update_payment_provider" model="ir.cron">
        <field name="name">Update Monero Payment Provider</field>
        <field name="model_id" ref="model_payment_provider"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_payment_provider()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="cron_check_expired_payments" model="ir.cron">
        <field name="name">Monero: Check Expired Payments</field>
        <field name="model_id" ref="model_monero_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expired_payments()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Issue 9 fix: this record's id ("cron_check_payment_status") was previously
         duplicated by a second <record> further down with the same id, which
         Odoo's loader treats as one record being redefined in place, and only the
         second definition ever actually existed, calling
         _cron_check_expired_payments() (already run separately by
         cron_check_expired_payments above) rather than the
         _cron_check_payment_status() this block's own code line named, which
         was never implemented in the first place. Rather than invent a new
         method that would just re-do what _cron_verify_pending_payments already
         does every 5 minutes below, this now-pointless record has been removed. -->

    <record id="cron_update_xmr_rates" model="ir.cron">
        <field name="name">Monero: Update Exchange Rates</field>
        <field name="model_id" ref="model_payment_provider"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_xmr_rates()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>    

    <record id="ir_cron_verify_monero_payments" model="ir.cron">
        <field name="name">Verify Monero Payments</field>
        <field name="model_id" ref="model_monero_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_verify_pending_payments()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    
    <record id="ir_cron_check_monero_daemons" model="ir.cron">
        <field name="name">Check Monero Daemons</field>
        <field name="model_id" ref="model_monero_daemon"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_daemon_status()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
