<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================= -->
    <!--   Monero Security Category    -->
    <!-- ============================= -->
    <!-- Since Odoo 19.0, res.groups no longer has a category_id field:
         grouping now goes through the res.groups.privilege model, which
         itself points at ir.module.category (verified in odoo/addons/base/models/
         res_groups.py of the 19.0 and 20.0 branches). -->
    <record id="module_category_monero" model="ir.module.category">
        <field name="name">Monero</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_monero" model="res.groups.privilege">
        <field name="name">Monero</field>
        <field name="category_id" ref="payment_monero_rpc.module_category_monero"/>
    </record>

    <!-- ============================= -->
    <!--          User Group           -->
    <!-- ============================= -->
    <record id="group_monero_user" model="res.groups">
        <field name="name">Monero User</field>
        <field name="privilege_id" ref="payment_monero_rpc.privilege_monero"/>
    </record>

    <!-- ============================= -->
    <!--        Manager Group          -->
    <!-- ============================= -->
    <record id="group_monero_manager" model="res.groups">
        <field name="name">Monero Manager</field>
        <field name="implied_ids" eval="[(4, ref('payment_monero_rpc.group_monero_user'))]"/>
        <field name="privilege_id" ref="payment_monero_rpc.privilege_monero"/>
    </record>

    <!-- ============================= -->
    <!--         Admin Group           -->
    <!-- ============================= -->
    <record id="group_monero_admin" model="res.groups">
        <field name="name">Monero Admin</field>
        <field name="implied_ids" eval="[(4, ref('payment_monero_rpc.group_monero_manager'))]"/>
        <field name="privilege_id" ref="payment_monero_rpc.privilege_monero"/>
    </record>

    <!-- ============================= -->
    <!--     Record-Level Security     -->
    <!-- ============================= -->

    <!-- Users may only read their own payment records -->
    <record id="rule_monero_payment_own" model="ir.rule">
        <field name="name">Own Monero Payments</field>
        <field name="model_id" ref="model_monero_payment"/>
        <field name="groups" eval="[(4, ref('payment_monero_rpc.group_monero_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('sale_order_id.partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- Managers and Admins have unrestricted access (no domain filter) -->
    <record id="rule_monero_payment_manager" model="ir.rule">
        <field name="name">All Monero Payments (Manager)</field>
        <field name="model_id" ref="model_monero_payment"/>
        <field name="groups" eval="[(4, ref('payment_monero_rpc.group_monero_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Issue 10 fix: security/ir.model.access.csv grants group_monero_admin
         read/write/create on payment.provider with no scoping rule, so a Monero
         Admin could read and write ANY payment provider in the database, not
         just its own, including other providers' credentials (Stripe, PayPal,
         etc). Scope it to the Monero provider only. -->
    <record id="rule_monero_provider_own" model="ir.rule">
        <field name="name">Monero Admin: Monero Provider Only</field>
        <field name="model_id" ref="payment.model_payment_provider"/>
        <field name="groups" eval="[(4, ref('payment_monero_rpc.group_monero_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('code', '=', 'monero_rpc')]</field>
    </record>

    <!-- Issue 11 fix: security/ir.model.access.csv grants group_monero_manager
         read/write/create on pos.order with no scoping rule, so a Monero Manager
         could write/create ANY POS order, not just Monero-paid ones. Scope it to
         orders that actually have a Monero payment attached
         (models/pos_payment.py adds monero_payment_id to pos.order). -->
    <record id="rule_monero_pos_order_own" model="ir.rule">
        <field name="name">Monero Manager: Monero-Paid POS Orders Only</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('payment_monero_rpc.group_monero_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('monero_payment_id', '!=', False)]</field>
    </record>
</odoo>

